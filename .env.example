# URL publique du site (canonique, sitemap, QR codes des cartes de visite).
# Sur Vercel, à défaut, l'adresse de production *.vercel.app est utilisée.
NEXT_PUBLIC_SITE_URL=https://www.inenco-energy.fr

# Indexation par Google & co : laisser vide (noindex) tant que le site n'est pas validé.
SITE_INDEXABLE=

# Réception des dossiers (factures + contact) par e-mail — serveur SMTP de l'entreprise.
# Sans SMTP : en développement, les dossiers sont écrits dans .data/dossiers/ ;
# en production, la réception est refusée (aucune facture perdue silencieusement).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="INENCO ENERGY <no-reply@inenco-energy.fr>"
DOSSIER_INBOX=dossiers@inenco-energy.fr
